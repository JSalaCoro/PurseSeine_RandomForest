## CPUE standardization models
models = c("Base","Month","DPC","Cluster")
#nominal
mods = list(
f1 = formula(y~as.factor(year)),
# Basic
f2 = formula(y~as.factor(year)+s(month,bs="cc",k=8)),
# DPC GAM
f3 = formula(y~as.factor(year)+s(month,bs="cc",k=8)+s(PC1,k=4)),# only 1 PC
# Tactic
f4 = formula(y~as.factor(year)+s(month,bs="cc",k=8)+as.factor(FT))
)
