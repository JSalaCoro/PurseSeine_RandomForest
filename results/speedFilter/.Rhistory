Next create the prediction dataset, and predict the expected CPUE and standard error for all candidate models by species. For comparisons, all estimated CPUE indices are standardized by their means.
# Extract Tweedie p
popt = do.call(c,lapply(gams,function(x){as.numeric(gsub(")","",strsplit(x$family[[1]], "=")[[1]][2]))}))
# ><>><>><>><>><>><>><>><>><>><>><>><>><>><>
# Make prediction data for year, month
# ><>><>><>><>><>><>><>><>><>><>><>><>><>><>
years = sort(unique(final_dat$year))
#select best month
months =  aggregate(y~month,final_dat,FUN=mean)$month
FTs =  aggregate(y~FT,final_dat,FUN=mean)$FT
nm = length(months)
nf = length(FTs)
PC = data.frame(t(apply(pcs[,1:(npc+1)],2,median)))
pdat = data.frame(year = rep(years,each=nm*nf),month=months,FT=rep(FTs,each=nm),PC)
pred = lapply(gams,function(x){
p <- predict(x,pdat,type="link",se=T)
data.frame(pdat,mu=exp(p$fit),se=p$se.fit)
})
# Create Annual Indices
idxs  = do.call(rbind,Map(function(x,y){
pr = aggregate(mu~year,x,mean)
df = data.frame(year=pr$year,index=pr$mu)
se2 = aggregate(se^2~year,x,mean)$`se^2`
df$se = sqrt(se2)
df$mu = pr$mu/mean(pr$mu) # normalize
df$lci = exp(log(df$mu)-1.96*df$se)
df$uci = exp(log(df$mu)+1.96*df$se)
df$lci = df$lci/mean(df$mu)
df$uci = df$uci/mean(df$mu)
df$model = paste(y)
df
},x=pred,y=models))
idxs$model =factor(idxs$model,levels=models)
ggplot(idxs,aes(year,mu,color=model))+theme_bw()+
geom_ribbon(aes(ymin = lci, ymax = uci,fill=model),alpha=0.2,col=0)+
geom_line()+geom_point()+geom_hline(yintercept = 1,linetype=2)+sc+th+
ylab("Normalized CPUE")+xlab("Year")
# fit final tweedie DPC-GAMM  with random vessel effect
final =   gamm(y~as.factor(year)+s(month,bs="cc",k=8)+s(PC1,k=4),
data=final_dat,family=Tweedie(p=popt[3]),
random=list(vessel=~1),method="REML")
# fit final tweedie DPC-GAMM  with random vessel effect
final =   gamm(y~as.factor(year)+s(month,bs="cc",k=8)+s(PC1,k=4),
data=final_dat,family=Tweedie(p=popt[3]),
random=list(vessel=~1),method="REML")
save(final, file = "final.Rdata")
p <- predict(final$gam,pdat,type="link",se=T) # for gamm use $gam
predI = data.frame(pdat,mu=exp(p$fit),se=p$se.fit)
# Normalized DPC-V GAMM Index
pr = aggregate(mu~year,predI,mean)
idx = data.frame(year=pr$year,index=pr$mu)
se2 = aggregate(se^2~year,predI,mean)$`se^2`
idx$se = sqrt(se2)
idx$mu = pr$mu/mean(pr$mu) # normalize
idx$lci = exp(log(idx$mu)-1.96*idx$se)
idx$uci = exp(log(idx$mu)+1.96*idx$se)
idx$lci = idx$lci/mean(idx$mu)
idx$uci = idx$uci/mean(idx$mu)
idx$model = "DPC-V"
# Combine
idxc = rbind(idxs[idxs$model=="DPC",], idx)
ggplot(idxc,aes(year,mu,color=model))+theme_bw()+
geom_ribbon(aes(ymin = lci, ymax = uci,fill=model),alpha=0.2,col=0)+
geom_line()+geom_point()+geom_hline(yintercept = 1,linetype=2)+sc+th+
ylab("Normalized CPUE")+xlab("Year")
